<?xml version="1.0"?>
<package format="3">
  <name>robot_patrol</name>
  <version>0.1.0</version>
  <description>Local route and multi-point patrol executor</description>
  <maintainer email="dev@example.com">ubuntu</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>patrol_interfaces</depend>
  <depend>hk_camera</depend>
  <depend>ocr_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>action_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-yaml</depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>ocr_node</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
