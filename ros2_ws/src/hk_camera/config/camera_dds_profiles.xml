<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>camera_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>camera_shared_memory</transport_id>
      <type>SHM</type>
      <!-- A full 1080p BGR frame is 6,220,800 bytes. The Fast DDS
           default 512 KiB segment cannot retain a burst of these frames. -->
      <segment_size>67108864</segment_size>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="camera_image_transport" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>camera_udp</transport_id>
        <transport_id>camera_shared_memory</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
