<?xml version="1.0"?>
<package format="3">
  <name>fastlio_loop_closure</name>
  <version>0.1.0</version>
  <description>Live 6DoF keyframe loop closure and corrected PCD backend for FAST-LIO.</description>
  <maintainer email="jkbot@example.com">jkbot</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-open3d</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
