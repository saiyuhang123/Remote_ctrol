  <!-- ================= Gazebo 扩展 ================= -->
  <!-- 速腾 16 线三维雷达 RS-LiDAR-16（简化几何体，车顶正中） -->
  <link name="rslidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.08"/></geometry>
      <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.08"/></geometry>
    </collision>
  </link>
  <joint name="rslidar_joint" type="fixed">
    <origin xyz="0.09 0 0.45" rpy="0 0 0"/>
    <parent link="Frame"/>
    <child link="rslidar_link"/>
  </joint>

  <!-- 二维雷达 hi_driver（简化几何体，车顶前部；真实安装位到货后再校准） -->
  <link name="laser_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="laser_joint" type="fixed">
    <origin xyz="0.35 0 0.37" rpy="0 0 0"/>
    <parent link="Frame"/>
    <child link="laser_link"/>
  </joint>

  <!-- 外观颜色 -->
  <gazebo reference="Frame"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="steering_1"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="steering_2"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="steering_3"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="steering_4"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="laser_link"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rslidar_link"><material>Gazebo/Black</material></gazebo>

  <!-- 轮子摩擦参数（4 轮一致） -->
  <gazebo reference="wheel_1"><material>Gazebo/Black</material><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="wheel_2"><material>Gazebo/Black</material><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="wheel_3"><material>Gazebo/Black</material><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="wheel_4"><material>Gazebo/Black</material><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>

  <!-- 阿克曼驱动：前转向(steering_1=右前/steering_2=左前) + 4 轮驱动，订阅 /cmd_vel(Twist)
       阿克曼底盘不能原地旋转，纯角速度指令不会动车，属预期行为 -->
  <gazebo>
    <plugin name="chassis_ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
      <ros></ros>
      <update_rate>30</update_rate>
      <front_left_joint>wheel_2_joint</front_left_joint>
      <front_right_joint>wheel_1_joint</front_right_joint>
      <rear_left_joint>wheel_4_joint</rear_left_joint>
      <rear_right_joint>wheel_3_joint</rear_right_joint>
      <left_steering_joint>steering_2_joint</left_steering_joint>
      <right_steering_joint>steering_1_joint</right_steering_joint>
      <max_steering_angle>0.53</max_steering_angle>
      <max_speed>2.0</max_speed>
      <left_steering_pid_gain>100 0 3</left_steering_pid_gain>
      <right_steering_pid_gain>100 0 3</right_steering_pid_gain>
      <linear_velocity_pid_gain>20 0 0</linear_velocity_pid_gain>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>Frame</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
    </plugin>
  </gazebo>

  <!-- 发布真实关节角度到 /joint_states（RViz 可见前轮偏转） -->
  <gazebo>
    <plugin name="chassis_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros></ros>
      <joint_name>steering_1_joint</joint_name>
      <joint_name>steering_2_joint</joint_name>
      <joint_name>wheel_1_joint</joint_name>
      <joint_name>wheel_2_joint</joint_name>
      <joint_name>wheel_3_joint</joint_name>
      <joint_name>wheel_4_joint</joint_name>
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>

  <!-- 速腾 16 线（合同规格：垂直 70° 即 -55°~+15°，盲区 0.2m，量程 100m，水平 0.4°），发 /rslidar_points -->
  <gazebo reference="rslidar_link">
    <sensor name="rslidar" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <ray>
        <scan>
          <horizontal>
            <samples>900</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1.0</resolution>
            <min_angle>-0.95993109</min_angle>
            <max_angle>0.26179939</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.2</min>
          <max>100.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="rslidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=rslidar_points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>rslidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 二维雷达：360°（0.5° 分辨率），发 /scan，Nav2 建图定位用 -->
  <gazebo reference="laser_link">
    <sensor name="laser" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
